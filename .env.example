# Nexora Configuration
# Copy this file to .env and adjust values as needed.

# Application
NEXORA_APP_ENV=development
NEXORA_HOST=127.0.0.1
NEXORA_PORT=8000

# Crawling defaults
NEXORA_MAX_CRAWL_DEPTH=3
NEXORA_MAX_PAGES=500
NEXORA_REQUEST_TIMEOUT=30.0
NEXORA_MAX_CONCURRENCY=5
NEXORA_DELAY_BETWEEN_REQUESTS=1.0
NEXORA_MAX_RESPONSE_SIZE=10485760

# Extraction
NEXORA_DEFAULT_EXTRACTION_STRATEGY=trafilatura

# Output
NEXORA_OUTPUT_DIR=output
NEXORA_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI / AI Features (optional)
# Paste your API key below to enable Chunking + Embedding + RAG Enhancement.
# Leave blank to skip AI features — all other crawling/extraction still works.
#
# If using an alternative OpenAI-compatible provider (e.g. OpenRouter, DeepSeek,
# Groq, Together, Ollama, AvalAI, etc.), provide their base URL below.
# Example: https://openrouter.ai/api/v1  OR  https://api.deepseek.com/v1
# Default if left blank: https://api.openai.com/v1
# ─────────────────────────────────────────────────────────────────────────────
NEXORA_OPENAI_API_KEY=
NEXORA_OPENAI_BASE_URL=
NEXORA_EMBEDDING_MODEL=text-embedding-3-small
NEXORA_LLM_MODEL=gpt-4o-mini
NEXORA_AI_CONCURRENCY=3
